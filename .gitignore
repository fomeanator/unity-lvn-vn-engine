.DS_Store
Thumbs.db

# Local
*.local
/tmp/

# Local Unity sandbox / test harness. The EXPORT TEMPLATE skeleton is
# committed (Boot.cs + asmdef, ProjectSettings, Packages manifest, UI theme)
# so /v1/export works from any fresh clone; everything else stays local.
/sandbox/*
!/sandbox/Packages/
/sandbox/Packages/*
!/sandbox/Packages/manifest.json
!/sandbox/ProjectSettings/
!/sandbox/Assets/
/sandbox/Assets/*
!/sandbox/Assets/Sandbox/
!/sandbox/Assets/Sandbox.meta
!/sandbox/Assets/Resources/
!/sandbox/Assets/Resources.meta
!/sandbox/Assets/Icon/
!/sandbox/Assets/Icon.meta
!/sandbox/Assets/Editor/
!/sandbox/Assets/Editor.meta

# Built 3D sets: a prefab is only GUID references into the art kits it was
# assembled from, and those kits are not redistributable. Rebuild them from
# the menu (Elvin/3D sets/…) after importing the kits.
/sandbox/Assets/Resources/Sets/

# Stray screenshots
Screenshot*.png
*_demo.png

# Release build artifacts
/dist/

# Runtime player saves written by the server's /v1/state (per-user state mirror)
server/content/state/
panel/public/docs/content/
server/website/docs/
server/content/.cache/

# On-demand ASTC transcodes (server/astc.go) — generated next to their PNG/JPG
# source on first request, regenerable any time astcenc is on PATH; never a
# thing to commit (a re-uploaded source would leave a stale sidecar behind).
*.astc

# On-demand downscaled texture variants (server/downscale.go) — generated next
# to their full-size source on first request; same regenerable-sidecar rule.
*@2k.png
*@2k.jpg
*@2k.jpeg

# On-demand KTX2/BasisU encodes (server/ktx2.go) — same regenerable-sidecar rule.
*.ktx2

# Root-level texture-compressor probes. These are temporary variants emitted by
# local asset experiments; their source assets live elsewhere and nothing in
# the project references these files directly.
/cr_transcoded_*.dds
/cr_transcoded_*.ktx

# Licensed heroine art pack — LOCAL TESTING ONLY, never publish (dist/Перс.rar)
server/content/sprites/hill/

# bundle import sources (licensed art, ~1GB) and runtime version history
content/cold/
server/content/.history/

# Demo content lives in its own repo (lvn-demo-content); fetch with
# scripts/fetch-demo-content.sh. The engine repo is code only. (Anchored:
# panel/public/play/content — the playground's tiny demo pack — stays tracked.)
/server/content/
/content/

# OS noise and local build outputs
.DS_Store
/dist/

# Deploy/build artifacts — regenerated, never hand-edited:
# server/website is `npm run deploy` output of the Studio app;
# lvns.wasm copies are built from tools/lvnconv/wasm (panel npm scripts / pages.yml).
/server/website/
panel/public/lvns.wasm
panel/public/play/lvns.wasm

# qa/monkey.sh: прогоны APK-смоука (скриншоты, logcat)
/qa/reports/
# qa/run-all.sh: собранный для PlayMode-смоука Go-сервер
/qa/bin/

# Внутренние рабочие аудиты сессий: разбирают контент и прод-инфраструктуру
# партнёра, а репозиторий движка ПУБЛИЧНЫЙ. Файлы остаются на диске, но не
# уезжают в открытый доступ — держать их в приватном месте.
/AUDIT-*.md
/ADOPTION-*.md

# Мусор batch-прогонов Unity (-runTests создаёт сцену на каждый запуск,
# краш-дампы падают в корень проекта) — копится и лезет в git status.
/unity/TestHost/Assets/InitTestScene*.unity
/unity/TestHost/Assets/InitTestScene*.unity.meta
/unity/TestHost/mono_crash.*.json
/unity/TestHost/mono_crash.*.blob

# Личные заметки в docs/ — директория отслеживаемая, и широкий `git add`
# утащил бы их в ПУБЛИЧНЫЙ репозиторий вместе с полезным.
/docs/supergame.txt
/docs/*.private.md

# локальные артефакты рабочей машины
unity.licence
/push
.codex/
.agents/
# vendor пакетов .lvns — восстанавливается `lvnconv deps sync` (docs/packages.md)
lvns_packages/
server/content/packages/

# QA-артефакты прогонов (логи сборок, кадры с устройства, переборы вариантов
# освещения). Это следы отладки, а не исходники: десятки мегабайт, которые
# устаревают на следующем прогоне.
#
# А вот САМИ ПРОГОНЫ — исходники, и они здесь же. Правило было записано как
# «qa/ целиком», при пяти отслеживаемых скриптах внутри: правку в run-all.sh
# git отказывался принимать («paths are ignored»), а новый скрипт молча не
# попадал ни в коммит, ни в снимок дерева, который тот же run-all.sh и делает.
/qa/*
!/qa/*.sh
# И вспомогательные инструменты стендов на питоне: медленный сервер, которым
# воспроизводят тормозящую сеть, — такой же исходник, как сам стенд.
!/qa/*.py
# Стенды для сквозных проверок — тоже исходники, а не мусор прогона: Go-страж
# пересобирает их и сверяет с образцами, вложенными в C#-тест. Без них проверка
# зелена только на этой машине.
!/qa/fixtures/
# Тот же мусор, но в стенде: он бывает вложенным (batchmode пишет отчёты
# относительно проекта). Правило с косой внутри привязано к корню, поэтому
# вложенные каталоги приходится называть отдельно.
unity/TestHost/qa/
# Контент, случайно оказавшийся внутри инструмента (запуск сервера не из корня).
tools/lvnconv/server/
# Кадры для README: их снимает ReadmeShots прямо из редактора, десятки мегабайт
# на прогон. В репозиторий едут только выбранные, уже уложенные в docs/img.
readme-shots/

# Лаборатория оболочки: в репозиторий едут только исходники и настройки —
# импортированное Unity собирает у себя.
ui-lab/Library/
ui-lab/Logs/
ui-lab/Temp/
ui-lab/obj/
ui-lab/UserSettings/
